# ============================================
# API 提供商选择
# ============================================
# 选项: openai (default) 或 modelscope
API_PROVIDER=modelscope

# ============================================
# OpenAI API 配置（官方 API）
# ============================================
# 要使用 OpenAI，带上你的 API Key
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================
# ModelScope API 配置（需要使用中文模型或免费方案）
# ============================================
# 1. 访问 https://modelscope.cn/
# 2. 注册或登录
# 3. 进入个人中心 -> API Token 下载访问令牌
MODELSCOPE_ACCESS_TOKEN=ms-2c7be8f0-9d97-43b3-bee8-0f0eb72a8a81

# ============================================
# 使用说明
# ============================================
# 方案 A: OpenAI 官方 API
# 1. 将 API_PROVIDER 改为 openai
# 2. 填入你的 OPENAI_API_KEY
# 3. 优点: 模型性能最好, 高效稳定
# 4. 缺点: 需要国际信用卡付费

# 方案 B: ModelScope API
# 1. 将 API_PROVIDER 改为 modelscope
# 2. 填入你的 MODELSCOPE_ACCESS_TOKEN
# 3. 优点: 免费/低优惨, 支持国内模型
# 4. 缺点: 性能可能池量

# 建议: 上串了两个配置后, 先用 OpenAI 测试功能是否正常
OPENAI_API_BASE=https://api.openai.com/v1  # 可选, 默认即可
# OPENAI_API_TYPE=azure  # 可选, 年不需要 Azure OpenAI 的话可以删除

